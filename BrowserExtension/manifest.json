{
  "manifest_version": 3,
  "name": "CreditWatch Connector",
  "version": "0.4.0",
  "description": "Envia somente medidores visíveis de uso para o CreditWatch local.",
  "permissions": ["activeTab", "scripting", "tabs"],
  "action": { "default_title": "Atualizar CreditWatch" },
  "background": { "service_worker": "service-worker.js" },
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "128": "icon-128.png" }
}
